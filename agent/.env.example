# Same MongoDB as the API (the agent stores runs, traces and the RAG index there).
MONGODB_URI=mongodb://127.0.0.1:27017/jd-platform
# Must match the API's AGENT_SHARED_SECRET.
AGENT_SHARED_SECRET=dev-agent-secret-change-me
# Where settled runs are POSTed back (signed).
API_CALLBACK_URL=http://localhost:5000/api/internal/agent-callback

# LLM: auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenRouter if OPENROUTER_API_KEY
# is set, else the deterministic agents. Or force: anthropic | openrouter | heuristic.
LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=
MODEL_LARGE=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_SMALL=nvidia/nemotron-3.5-lightning:free
# USD per million tokens, used for cost tracking (0 for OpenRouter :free models).
PRICE_LARGE_IN=0
PRICE_LARGE_OUT=0
PRICE_SMALL_IN=0
PRICE_SMALL_OUT=0

# Embeddings: hashing (offline), voyage (+ VOYAGE_API_KEY) or openrouter (+ OPENROUTER_API_KEY)
EMBEDDINGS_PROVIDER=hashing
EMBEDDINGS_MODEL=nvidia/nemotron-3.5-embed-8b:free
RETRIEVAL_MODE=hybrid
USE_RERANKER=true

# Guardrails / budgets
INTAKE_MAX_TURNS=6
CRITIC_MAX_ITERS=2
MAX_TOOL_CALLS=8
MAX_TOKENS_PER_RUN=60000
DAILY_TOKEN_BUDGET_PER_USER=400000
CONFIDENCE_THRESHOLD=0.6
PAY_TRANSPARENCY_REQUIRED=true
PROMPT_VERSION=v1.0
