# Same MongoDB as the API (the agent stores runs, traces and the RAG index there).
MONGODB_URI=mongodb://127.0.0.1:27017/jd-platform
# Must match the API's AGENT_SHARED_SECRET.
AGENT_SHARED_SECRET=dev-agent-secret-change-me
# Where settled runs are POSTed back (signed).
API_CALLBACK_URL=http://localhost:5000/api/internal/agent-callback

# LLM: auto = Anthropic when ANTHROPIC_API_KEY is set, otherwise the deterministic agents.
LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
MODEL_LARGE=claude-sonnet-5-5
MODEL_SMALL=claude-haiku-5-5
# USD per million tokens, used for cost tracking — set to your contract prices.
PRICE_LARGE_IN=3
PRICE_LARGE_OUT=15
PRICE_SMALL_IN=1
PRICE_SMALL_OUT=5

# Embeddings: hashing (offline, default) or voyage (+ VOYAGE_API_KEY)
EMBEDDINGS_PROVIDER=hashing
RETRIEVAL_MODE=hybrid
USE_RERANKER=true

# Guardrails / budgets
INTAKE_MAX_TURNS=6
CRITIC_MAX_ITERS=2
MAX_TOOL_CALLS=8
MAX_TOKENS_PER_RUN=60000
DAILY_TOKEN_BUDGET_PER_USER=400000
CONFIDENCE_THRESHOLD=0.6
PAY_TRANSPARENCY_REQUIRED=true
PROMPT_VERSION=v1.0
