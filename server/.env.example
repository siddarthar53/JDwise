# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/jd-platform
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jd-platform
MONGODB_URI=mongodb://127.0.0.1:27017/jd-platform

# Secret used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-secret

# Port the API server listens on.
PORT=5000

# Origin of the Vite frontend (for CORS). Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:8080,http://localhost:8081

# ---- Agent service (agent/) -------------------------------------------------
# Base URL of the Python agent service. Leave empty to run with the legacy
# rule-based question flow only (Baseline v0).
AGENT_URL=http://localhost:8001
# Shared HMAC secret for API <-> agent calls. Must match the agent's AGENT_SHARED_SECRET.
AGENT_SHARED_SECRET=dev-agent-secret-change-me

# ---- Ops agent ----------------------------------------------------------------
# How often to scan for JDs stuck in review (minutes; 0 disables) and the age threshold (hours).
OPS_SCAN_MINUTES=60
OPS_STUCK_HOURS=48
